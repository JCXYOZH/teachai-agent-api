APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# PostgreSQL 16. Replace CHANGE_ME before use.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@10.101.155.121:5432/teachai_agent
TEST_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@10.101.155.121:5432/teachai_agent_test

# Generate with secrets.token_urlsafe(48).
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false

# Registration email verification.
# memory is test-only, log prints codes to the server log, agentsend sends real mail.
# AgentSend REST API docs: https://agentsend.io/docs/getting-started
EMAIL_DELIVERY=log
AGENTSEND_API_KEY=
AGENTSEND_INBOX_NAME=teachai-support
AGENTSEND_INBOX_ID=
AGENTSEND_BASE_URL=https://api.agentsend.io
AGENTSEND_TIMEOUT_SECONDS=20
VERIFICATION_CODE_TTL_SECONDS=600
VERIFICATION_RESEND_SECONDS=60
VERIFICATION_MAX_ATTEMPTS=5

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
TRUST_PROXY_HEADERS=false

# Local disk storage for uploaded assets and extracted content.
ASSET_STORAGE_ROOT=E:/Backups/Data/TeachAIAgent
ASSET_MAX_BYTES=52428800
ASSET_MAX_EXTRACTED_CHARS=2000000
ASSET_PARSE_TIMEOUT_SECONDS=60

# Classroom narration (text-to-speech). Use qwen for qwen3-tts-flash with the
# Cherry voice, or edge-tts for the keyless zh-CN-XiaoxiaoNeural fallback.
# Per-user overrides live in provider settings.
TTS_PROVIDER_ID=qwen
TTS_GENERATION_TIMEOUT_SECONDS=120
TTS_MAX_TEXT_CHARS=6000
TTS_MAX_AUDIO_BYTES=20971520

# Classroom illustrations. Qwen Image is the primary provider; Pollinations is
# used automatically as a keyless fallback. Both results are normalized to WebP
# and stored under ASSET_STORAGE_ROOT.
IMAGE_PROVIDER_ID=qwen
IMAGE_MODEL=qwen-image-3.0
IMAGE_GENERATION_TIMEOUT_SECONDS=180
IMAGE_MAX_DOWNLOAD_BYTES=26214400
IMAGE_MAX_WIDTH=1600
IMAGE_MAX_HEIGHT=900
IMAGE_WEBP_QUALITY=82
IMAGE_MAX_PER_CLASSROOM=6
IMAGE_TARGET_WIDTH=1024
IMAGE_TARGET_HEIGHT=576
IMAGE_POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
IMAGE_POLLINATIONS_MODEL=flux
IMAGE_FALLBACK_CHAIN=pollinations
IMAGE_HF_ENDPOINT=https://api-inference.huggingface.co/models
IMAGE_HF_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_HF_TOKEN=
IMAGE_CLOUDFLARE_ACCOUNT_ID=
IMAGE_CLOUDFLARE_API_TOKEN=
IMAGE_CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Local llama.cpp OpenAI-compatible endpoint.
LLAMA_BASE_URL=http://127.0.0.1:65535/v1
LLAMA_API_KEY=CHANGE_ME
LLAMA_MODEL=Qwen3.6-35B-A3B

# Classroom generation limits.
CLASSROOM_MATERIAL_CHAR_LIMIT=12000
CLASSROOM_GENERATION_TIMEOUT_SECONDS=900

# Official providers, filled in Phase 3.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
# Optional DashScope fallback used when QWEN_API_KEY is empty.
DASHSCOPE_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=
