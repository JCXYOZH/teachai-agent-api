# 生产环境变量模板。
# 1. 复制为 .env.production，填写真实值后 chmod 600。
# 2. .env.production 已被 .dockerignore 排除，不会进入镜像，也不提交到 Git。

APP_ENV=production
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# 容器使用 host 网络，PostgreSQL 与容器同机，因此地址为 127.0.0.1。
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@127.0.0.1:5432/teachai_agent
TEST_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@127.0.0.1:5432/teachai_agent_test

# 用 python -c "import secrets; print(secrets.token_urlsafe(48))" 生成，至少 32 字符。
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# 生产走 HTTPS，refresh cookie 必须带 Secure。
COOKIE_SECURE=true
# 留空表示仅对当前主机生效；填 .example.com 时子域共享。
COOKIE_DOMAIN=

# 前后端同源部署，CORS 只保留正式域名。
CORS_ORIGINS=https://ai.offer.us.ci
# 由 Nginx 转发，必须开启，否则客户端 IP 与协议识别错误。
TRUST_PROXY_HEADERS=true

# 注册验证码：生产强制走 AgentSend 真实发信。
EMAIL_DELIVERY=agentsend
AGENTSEND_API_KEY=
AGENTSEND_INBOX_NAME=teachai-support
AGENTSEND_INBOX_ID=
AGENTSEND_BASE_URL=https://api.agentsend.io
AGENTSEND_TIMEOUT_SECONDS=20
VERIFICATION_CODE_TTL_SECONDS=600
VERIFICATION_RESEND_SECONDS=60
VERIFICATION_MAX_ATTEMPTS=5

# 资产目录：容器内路径与宿主机挂载点保持一致。
ASSET_STORAGE_ROOT=/data/TeachAIAgent
ASSET_MAX_BYTES=52428800
ASSET_MAX_EXTRACTED_CHARS=2000000
ASSET_PARSE_TIMEOUT_SECONDS=60

# 本地 llama.cpp（OpenAI 兼容接口）。
LLAMA_BASE_URL=http://47.120.68.25:65535/v1
LLAMA_API_KEY=CHANGE_ME
LLAMA_MODEL=Qwen3.6-35B-A3B

# 旁白合成。
TTS_PROVIDER_ID=qwen
TTS_GENERATION_TIMEOUT_SECONDS=120
TTS_MAX_TEXT_CHARS=6000
TTS_MAX_AUDIO_BYTES=20971520

# 课堂配图：Qwen Image 主通道 + Pollinations 免 Key 兜底。
IMAGE_PROVIDER_ID=qwen
IMAGE_MODEL=qwen-image-3.0
IMAGE_GENERATION_TIMEOUT_SECONDS=180
IMAGE_MAX_DOWNLOAD_BYTES=26214400
IMAGE_MAX_WIDTH=1600
IMAGE_MAX_HEIGHT=900
IMAGE_WEBP_QUALITY=82
IMAGE_MAX_PER_CLASSROOM=6
IMAGE_TARGET_WIDTH=1024
IMAGE_TARGET_HEIGHT=576
IMAGE_POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
IMAGE_POLLINATIONS_MODEL=flux
IMAGE_FALLBACK_CHAIN=pollinations
IMAGE_HF_ENDPOINT=https://api-inference.huggingface.co/models
IMAGE_HF_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_HF_TOKEN=
IMAGE_CLOUDFLARE_ACCOUNT_ID=
IMAGE_CLOUDFLARE_API_TOKEN=
IMAGE_CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-1-schnell

# 生成与导出限制。反向代理的超时时间必须高于这些值。
OUTLINE_GENERATION_TIMEOUT_SECONDS=600
OUTLINE_MATERIAL_CHAR_LIMIT=16000
CLASSROOM_MATERIAL_CHAR_LIMIT=12000
CLASSROOM_GENERATION_TIMEOUT_SECONDS=900
EXPORT_MAX_BYTES=41943040

# 官方 Provider 密钥（可留空，用户在设置页自行配置）。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
DASHSCOPE_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=

# 容器启动行为：等待数据库、自动执行 alembic upgrade head。
# 手工控制迁移时把 RUN_MIGRATIONS 设为 0。
DB_WAIT_TIMEOUT_SECONDS=90
DB_WAIT_INTERVAL_SECONDS=2